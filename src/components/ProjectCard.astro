---
import type { ProjectRepoMeta } from "../data/project-meta";
import type { ProjectRole } from "../utils/project-status";
import ProjectStatus from "./ProjectStatus.astro";

interface Props {
  title: string;
  description: string;
  tech: string[];
  github?: string;
  slug: string;
  role: ProjectRole;
  lastTouched?: Date;
  repoMeta?: ProjectRepoMeta;
}

const {
  title,
  description,
  tech,
  slug,
  role,
  lastTouched,
  github,
  repoMeta,
} = Astro.props;
---

<article class="project-card">
  <a href={`/stuff/${slug}`} class="card-link">
    <h3 class="card-title">
      <span class="card-title-text">{title}</span>
      <span class="card-role">{role}</span>
    </h3>
  </a>

  <a href={`/stuff/${slug}`} class="card-link card-link-body">
    <p class="card-description">{description}</p>

    <div class="card-tech">
      {tech.map((t) => <span class="tech-pill">{t}</span>)}
    </div>
  </a>

  <ProjectStatus
    role={role}
    lastTouched={lastTouched}
    github={github}
    repoMeta={repoMeta}
    variant="card"
    showMeta={false}
  />

  <style>
    .project-card {
      display: flex;
      flex-direction: column;
      background-color: color-mix(
        in srgb,
        var(--color-bg-secondary) 50%,
        transparent
      );
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition:
        border-color var(--transition-fast),
        box-shadow var(--transition-fast);
    }

    .project-card:hover {
      border-color: var(--color-accent);
      box-shadow: var(--shadow-md);
    }

    .card-link {
      display: block;
      padding: var(--space-lg) var(--space-lg) 0;
      text-decoration: none;
      color: inherit;
    }

    .card-link-body {
      padding-top: var(--space-sm);
      padding-bottom: var(--space-lg);
    }

    .project-card:has(.project-status) .card-link-body {
      padding-bottom: var(--space-md);
    }

    .card-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
      width: 100%;
      font-size: var(--font-size-lg);
      line-height: var(--leading-tight);
      min-width: 0;
      margin-bottom: var(--space-xs);
    }

    .card-title-text {
      min-width: 0;
      font-weight: 600;
      color: var(--color-text);
    }

    .card-role {
      flex-shrink: 0;
      margin-left: auto;
      font-size: inherit;
      font-weight: 400;
      color: var(--color-text-secondary);
      white-space: nowrap;
    }

    .card-description {
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
      line-height: var(--leading-relaxed);
      margin-bottom: var(--space-md);
    }

    .card-tech {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs);
      min-width: 0;
    }

    .tech-pill {
      font-size: var(--font-size-xs);
      color: var(--color-accent);
      background-color: color-mix(
        in srgb,
        var(--color-accent) 10%,
        transparent
      );
      padding: 2px var(--space-sm);
      border-radius: var(--radius-full);
    }
  </style>
</article>
