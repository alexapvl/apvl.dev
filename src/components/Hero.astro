<style>
  .hero {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-lg);
    padding-top: calc(20vh - 2rem);
  }

  .hero-content {
    max-width: 600px;
  }

  .hero-header {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    margin-bottom: var(--space-sm);
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .hero-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .hero-link:hover {
    color: var(--color-accent);
  }

  .signature {
    width: 60px;
    height: auto;
    color: var(--color-text);
    flex-shrink: 0;
  }

  .signature-path {
    stroke-dasharray: 1307;
    stroke-dashoffset: 1307;
    animation: draw-signature 1s forwards;
  }

  @keyframes draw-signature {
    to {
      stroke-dashoffset: 0;
    }
  }

  .greeting {
    font-size: var(--font-size-lg);
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .name {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    color: var(--color-text);
  }

  .hero-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-xl);
  }

  .hero-now {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-xl);
  }

  .hero-now:last-child {
    margin-bottom: 0;
  }

  button.hero-link {
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
    padding: 0;
  }

  .email-copy {
    position: relative;
    display: inline-grid;
    place-items: center start;
  }

  .email-text,
  .email-copied {
    grid-area: 1 / 1;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .email-text {
    opacity: 1;
    transform: translateY(0);
  }

  .email-copied {
    color: var(--color-accent);
    opacity: 0;
    transform: translateY(4px);
    white-space: nowrap;
  }

  .email-copy.copied .email-text {
    opacity: 0;
    transform: translateY(-4px);
  }

  .email-copy.copied .email-copied {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: calc(15vh - 1.5rem);
    }

    .hero-header {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-md);
    }

    .signature {
      width: 60px;
    }

    .name {
      font-size: var(--font-size-2xl);
    }
  }
</style>

<script>
  function initEmailCopy() {
    document.querySelectorAll(".email-copy").forEach((button) => {
      if (!(button instanceof HTMLElement) || button.dataset.copyBound) return;
      button.dataset.copyBound = "true";

      button.addEventListener("click", async () => {
        const email = button.getAttribute("data-email");
        if (!email) return;

        try {
          await navigator.clipboard.writeText(email);
          button.classList.add("copied");
          setTimeout(() => button.classList.remove("copied"), 1500);
        } catch (err) {
          console.error("Failed to copy email:", err);
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initEmailCopy);
  initEmailCopy();
</script>
