---
// Navigation panel - expands upward from persistent bottom bar
---

<div id="nav-panel" class="nav-panel">
  <!-- Expandable keybinds (above the bottom bar) -->
  <div id="nav-keybinds" class="nav-keybinds" inert>
    <div class="nav-keybinds-inner">
      <ul class="keybinds-list">
        <li>
          <a class="keybind" href="/">
            <kbd aria-hidden="true">h</kbd>
            <span>home</span>
          </a>
        </li>
        <li>
          <a class="keybind" href="/stuff">
            <kbd aria-hidden="true">s</kbd>
            <span>stuff</span>
          </a>
        </li>
        <li>
          <a class="keybind" href="/thoughts">
            <kbd aria-hidden="true">t</kbd>
            <span>thoughts</span>
          </a>
        </li>
        <li>
          <button type="button" class="keybind" data-nav-action="back">
            <kbd class="kbd-icon" aria-hidden="true"
              ><svg
                viewBox="0 0 24 24"
                width="12"
                height="12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"
                ></path><line x1="18" y1="9" x2="12" y2="15"></line><line
                  x1="12"
                  y1="9"
                  x2="18"
                  y2="15"></line></svg
              ></kbd
            >
            <span>back</span>
          </button>
        </li>
        <li class="separator"></li>
        <li>
          <button type="button" class="keybind" data-nav-action="theme">
            <kbd aria-hidden="true">0</kbd>
            <span>toggle theme</span>
          </button>
        </li>
        <li>
          <button type="button" class="keybind" data-nav-action="music">
            <kbd aria-hidden="true">m</kbd>
            <span>toggle music</span>
          </button>
        </li>
        <li class="separator"></li>
      </ul>
    </div>
  </div>

  <!-- Persistent bottom bar -->
  <button
    type="button"
    class="nav-bottom"
    data-nav-action="toggle"
    aria-expanded="false"
    aria-controls="nav-keybinds"
  >
    <kbd aria-hidden="true">n</kbd>
    <span class="nav-label">
      <span class="label-collapsed">navigation</span>
      <span class="label-expanded" aria-hidden="true">close</span>
    </span>
  </button>
</div>

<style>
  .nav-panel {
    position: fixed;
    bottom: var(--space-lg);
    right: var(--space-lg);
    z-index: var(--z-overlay);
    background-color: color-mix(
      in srgb,
      var(--color-bg-secondary) 95%,
      transparent
    );
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  /* Expandable keybinds section */
  .nav-keybinds {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-keybinds-inner {
    overflow: hidden;
    min-height: 0;
  }

  .nav-panel.expanded .nav-keybinds {
    grid-template-rows: 1fr;
  }

  .keybinds-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm) 0 var(--space-xs);
  }

  .keybind {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    margin: 0;
    padding: 2px var(--space-md);
    appearance: none;
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .keybind:hover,
  .nav-bottom:hover {
    color: var(--color-text);
    background-color: color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .keybind:active,
  .nav-bottom:active {
    opacity: 0.72;
  }

  .keybinds-list li.separator {
    height: 1px;
    background-color: var(--color-border);
    margin: var(--space-xs) var(--space-md);
  }

  /* Persistent bottom bar */
  .nav-bottom {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    margin: 0;
    padding: var(--space-sm) var(--space-md); /* top-bottom, sides */
    appearance: none;
    background: none;
    border: 0;
    font: inherit;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-align: left;
    cursor: pointer;
    transition: padding 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-panel.expanded .nav-bottom {
    padding-top: var(--space-xs);
  }

  .nav-label {
    position: relative;
  }

  .label-collapsed,
  .label-expanded {
    transition: opacity 150ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .label-expanded {
    position: absolute;
    left: 0;
    opacity: 0;
  }

  .nav-panel.expanded .label-collapsed {
    opacity: 0;
  }

  .nav-panel.expanded .label-expanded {
    opacity: 1;
  }

  /* Disable transitions while restoring persisted state after route swaps */
  .nav-panel.state-sync .nav-keybinds,
  .nav-panel.state-sync .nav-bottom,
  .nav-panel.state-sync .label-collapsed,
  .nav-panel.state-sync .label-expanded {
    transition: none !important;
  }

  kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    padding: 2px 6px;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 -1px 0 var(--color-border);
  }

  kbd.kbd-icon {
    padding: 5px 5px;
  }

  kbd.kbd-icon svg {
    display: block;
  }

  .nav-panel :focus-visible {
    outline-offset: -2px;
  }

  /* Hide nav panel on mobile - keybinds are desktop-only */
  @media (max-width: 640px) {
    .nav-panel {
      display: none !important;
    }
  }
</style>
